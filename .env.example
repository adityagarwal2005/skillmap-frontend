# SkillMap frontend — environment variables
#
# Base URL of the Django API. Set this in Vercel (Settings → Environment
# Variables) for production; use .env.local for your machine.
#
#   Local dev  : http://127.0.0.1:8000
#   Production : https://skillmap-backend-498t.onrender.com   (Render)
#
REACT_APP_API_URL=http://127.0.0.1:8000

# Google Sign-In client ID (OAuth 2.0 Client ID, "Web application" type)
# from https://console.cloud.google.com/apis/credentials — leave unset to
# hide the "Continue with Google" button.
REACT_APP_GOOGLE_CLIENT_ID=
